{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MCP Observability Metrics",
    "type": "object",
    "properties": {
      "service": {
        "type": "string",
        "description": "Service emitting metric"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "latencyMs": {
        "type": "number"
      },
      "status": {
        "type": "string",
        "enum": [
          "success",
          "error"
        ]
      },
      "adFailure": {
        "type": "boolean"
      }
    },
    "required": [
      "service",
      "timestamp",
      "latencyMs",
      "status"
    ]
  },
  "sample": {
    "metrics": [
      {
        "service": "transport",
        "timestamp": "2025-10-16T17:00:09Z",
        "latencyMs": 123,
        "status": "success",
        "adFailure": false
      },
      {
        "service": "orchestrator",
        "timestamp": "2025-10-16T17:00:09Z",
        "latencyMs": 512,
        "status": "error",
        "adFailure": true
      }
    ]
  }
}